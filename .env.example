# Copy to .env and adjust for your environment.
# Also read by docker-compose.yml (postgres service) — single source of
# truth for the database credentials.
# Docker compose LAN default:
PGHOST=172.20.0.20
# Local dev without Docker:
# PGHOST=localhost
PGPORT=5432
PGDATABASE=network_logs
PGUSER=monitor
PGPASSWORD=monitor
PGCONNECT_TIMEOUT=3

# Telegram alerts (optional) — fresh HIGH/CRITICAL anomalies only.
# Create a bot with @BotFather for the token; get your chat id via
# @userinfobot or the getUpdates API.
# NOTIFY_TELEGRAM=1
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789,-987654321  # single user, or many, or a group
# NOTIFY_MIN_SEVERITY=HIGH
# TELEGRAM_API_BASE=https://api.telegram.org   # optional override
